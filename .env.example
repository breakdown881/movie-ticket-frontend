# ==========================================
# CINE-TICKET FRONTEND ENVIRONMENT VARIABLES
# ==========================================

# Base URL của Backend NestJS (Mặc định NestJS có global prefix /api/v1)
VITE_API_BASE_URL=http://localhost:3000/api/v1

# Địa chỉ gốc Backend server (dành cho swagger docs, uploads, media)
VITE_BACKEND_ORIGIN=http://localhost:3000

# Client App Info
VITE_APP_NAME="CineVerse - Đặt Vé Xem Phim Trực Tuyến"
VITE_APP_PORT=5173

# Cấu hình Real-time Seat Polling (milliseconds)
VITE_SEAT_POLLING_INTERVAL=3000

# Social Auth Credentials (Google / Facebook)
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
VITE_FACEBOOK_APP_ID=your_facebook_app_id
